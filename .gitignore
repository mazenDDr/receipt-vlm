.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.env
.env.*
.DS_Store

# live only on the GPU machine (anchored, so src/receipt_vlm/data/ is still tracked)
/data/
/models/
/wandb/

# outputs are pulled from the GPU machine; only the small run summaries are committed
outputs/*
!outputs/runs/
outputs/runs/*
!outputs/runs/*/
outputs/runs/*/*
!outputs/runs/*/summary.json
!outputs/runs/*/report.md
!outputs/runs/*/train_summary.json

# Staging for the pages and the model cards: generated by scripts/, rebuilt on demand.
# outputs/* already covers these; naming them keeps the intent explicit, since one holds
# 8 MB of receipt images that must not be swept in by a future rule change.
/outputs/site_data/
/outputs/label_audit/
/outputs/model_cards/
